{
  "name": "tavola-periodica-3d",
  "productName": "Tavola Periodica 3D",
  "version": "0.9.2",
  "description": "Tavola periodica interattiva con modelli atomici 3D esplorabili",
  "author": "Tavola Periodica 3D",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite",
    "data": "node scripts/build-data.mjs && node scripts/build-binding.mjs",
    "icon": "node scripts/make-icon.mjs",
    "build": "vite build",
    "start": "vite build && electron .",
    "dist": "vite build && electron-builder --win",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:linux": "vite build && electron-builder --linux",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "build": {
    "appId": "it.tavolaperiodica3d.app",
    "productName": "Tavola Periodica 3D",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Tavola Periodica 3D",
      "artifactName": "TavolaPeriodica3D-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "TavolaPeriodica3D-portable-${version}.exe"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.education",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": "AppImage",
      "category": "Education",
      "icon": "build/icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "G43r0",
        "repo": "tavola-periodica-3d",
        "releaseType": "release"
      }
    ]
  },
  "devDependencies": {
    "@dimforge/rapier3d-compat": "^0.19.3",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.10.0",
    "electron-builder": "^26.18.0",
    "three": "^0.186.1",
    "vite": "^8.3.5",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
