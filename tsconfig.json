{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "esnext.disposable", "dom"],
    "resolveJsonModule": true,
    "skipLibCheck": false
  },
  "include": ["src/**/*.js", "src/types.d.ts"]
}
